# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Telegram Mini App + Stars
TELEGRAM_BOT_TOKEN=
# Секрет для вебхука (тот же, что при setWebhook secret_token). Пробелы в начале/конце — обрежутся.
TELEGRAM_WEBHOOK_SECRET=

# Диагностика:
# GET https://ваш-домен/api/telegram/bot-check — username бота на сервере (сверьте с Mini App).
# GET https://ваш-домен/api/telegram/webhook-info — payments_ready должен быть true (url не пустой + pre_checkout_query).
#
# Оплата Stars (обязательно после деплоя, подставьте TELEGRAM_BOT_TOKEN и TELEGRAM_WEBHOOK_SECRET):
# curl -s "https://api.telegram.org/bot<TOKEN>/setWebhook" -H "Content-Type: application/json" -d '{
#   "url": "https://ваш-домен/api/telegram/webhook",
#   "secret_token": "<TELEGRAM_WEBHOOK_SECRET>",
#   "allowed_updates": ["message", "pre_checkout_query"]
# }'
# secret_token в setWebhook = TELEGRAM_WEBHOOK_SECRET на сервере. Без вебхука оплата зависает и падает с «Оплата не прошла».

# URL Mini App (кнопка /start в боте и web_app; без слэша в конце)
# NEXT_PUBLIC_APP_URL=https://matchai.live

# Один раз: кнопка меню слева от поля ввода → Mini App
# curl -s -X POST https://ваш-домен/api/telegram/setup-menu -H "X-Setup-Token: <TELEGRAM_WEBHOOK_SECRET>"

# Только локальная отладка в браузере без Telegram (обходит оплату). В продакшене не включать.
# ALLOW_FREE_FORECAST=true
# NEXT_PUBLIC_ALLOW_FREE_FORECAST=true

# Supabase (сессии оплаты + счётчики на главной)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # или legacy: SUPABASE_KEY=
# SQL: scripts/forecast-sessions.sql, scripts/app-global-stats.sql, scripts/test-feedback.sql
