# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Telegram Mini App + Stars
TELEGRAM_BOT_TOKEN=
# Секрет для вебхука (тот же, что при setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=

# Публичный URL приложения (для подсказки вебхука в логах; опционально)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Только локальная отладка в браузере без Telegram (обходит оплату). В продакшене не включать.
# ALLOW_FREE_FORECAST=true
# NEXT_PUBLIC_ALLOW_FREE_FORECAST=true

# Supabase (рекомендуется для Vercel: сессии между инстансами и вебхуком)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # или legacy: SUPABASE_KEY=
